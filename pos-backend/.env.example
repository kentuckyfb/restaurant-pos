PORT=8000
MONGODB_URI=
JWT_SECRET=
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Colombo

# Public address of the POS frontend, used in receipt links sent to customers
PUBLIC_APP_URL=

# Email receipts (any SMTP account; for Gmail use smtp.gmail.com, port 465 and an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS receipts via Notify.lk (https://notify.lk): Settings → API keys
NOTIFY_USER_ID=
NOTIFY_API_KEY=
NOTIFY_SENDER_ID=

# --- Security (production) ---
# Set NODE_ENV=production when hosted: hides error details and refuses to start with a weak JWT_SECRET.
# JWT_SECRET must be a random string of 32+ characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Behind a hosting proxy (Render, Railway, nginx) set TRUST_PROXY=1 so login lockouts see real addresses.
TRUST_PROXY=0
